<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/university-kg#"
     xml:base="http://example.org/university-kg"
     xmlns:kg="http://example.org/university-kg#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- ====================================================== -->
    <!-- Ontology -->
    <!-- ====================================================== -->

    <owl:Ontology rdf:about="http://example.org/university-kg">
        <rdfs:label>University Knowledge Graph Ontology</rdfs:label>
        <rdfs:comment>
            Clean conceptual ontology for representing university module knowledge.
            This version keeps only core academic graph nodes:
            Module, Week, Topic, Concept, Resource, Assessment, and ProcessedDocument.
            Definition, Example, Formula, and Application are not separate node classes.
            They may be stored as optional text properties on Concept nodes.
        </rdfs:comment>
    </owl:Ontology>


    <!-- ====================================================== -->
    <!-- Core Classes -->
    <!-- ====================================================== -->

    <owl:Class rdf:about="http://example.org/university-kg#Module">
        <rdfs:label>Module</rdfs:label>
        <rdfs:comment>A university teaching module or course.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#Week">
        <rdfs:label>Week</rdfs:label>
        <rdfs:comment>A teaching week within a module.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#Topic">
        <rdfs:label>Topic</rdfs:label>
        <rdfs:comment>A topic covered within a teaching week.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#Concept">
        <rdfs:label>Concept</rdfs:label>
        <rdfs:comment>A meaningful learning concept extracted from teaching material.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#Resource">
        <rdfs:label>Resource</rdfs:label>
        <rdfs:comment>A learning resource such as lecture notes, videos, seminar tasks, reading lists, or external links.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#Assessment">
        <rdfs:label>Assessment</rdfs:label>
        <rdfs:comment>An assessment item such as an exam, coursework, quiz, mock test, or in-class test.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#ProcessedDocument">
        <rdfs:label>Processed Document</rdfs:label>
        <rdfs:comment>A source document processed by the graph construction pipeline.</rdfs:comment>
    </owl:Class>


    <!-- ====================================================== -->
    <!-- Resource Subclasses -->
    <!-- ====================================================== -->

    <owl:Class rdf:about="http://example.org/university-kg#LectureNotes">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Resource"/>
        <rdfs:label>Lecture Notes</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#LectureVideoRecording">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Resource"/>
        <rdfs:label>Lecture Video Recording</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#SeminarTasks">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Resource"/>
        <rdfs:label>Seminar Tasks</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#SeminarTaskAnswers">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Resource"/>
        <rdfs:label>Seminar Task Answers</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#ReadingList">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Resource"/>
        <rdfs:label>Reading List</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#YouTubeVideo">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Resource"/>
        <rdfs:label>YouTube Video</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#PracticeQuestions">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Resource"/>
        <rdfs:label>Practice Questions</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#PastPaper">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Resource"/>
        <rdfs:label>Past Paper</rdfs:label>
    </owl:Class>


    <!-- ====================================================== -->
    <!-- Assessment Subclasses -->
    <!-- ====================================================== -->

    <owl:Class rdf:about="http://example.org/university-kg#Exam">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Assessment"/>
        <rdfs:label>Exam</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#MockTest">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Assessment"/>
        <rdfs:label>Mock Test</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#InClassTest">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Assessment"/>
        <rdfs:label>In-Class Test</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#Coursework">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Assessment"/>
        <rdfs:label>Coursework</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-kg#Quiz">
        <rdfs:subClassOf rdf:resource="http://example.org/university-kg#Assessment"/>
        <rdfs:label>Quiz</rdfs:label>
    </owl:Class>


    <!-- ====================================================== -->
    <!-- Object Properties -->
    <!-- ====================================================== -->

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#HAS_WEEK">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Module"/>
        <rdfs:range rdf:resource="http://example.org/university-kg#Week"/>
        <rdfs:label>has week</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#COVERS">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Week"/>
        <rdfs:range rdf:resource="http://example.org/university-kg#Topic"/>
        <rdfs:label>covers</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#HAS_CONCEPT">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Topic"/>
        <rdfs:range rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:label>has concept</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#RELATED_TO">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:range rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:label>related to</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#BUILDS_ON">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:range rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:label>builds on</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#PREREQUISITE_OF">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:range rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:label>prerequisite of</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#NEXT">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Week"/>
        <rdfs:range rdf:resource="http://example.org/university-kg#Week"/>
        <rdfs:label>next</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#HAS_RESOURCE">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/university-kg#Module"/>
                    <rdf:Description rdf:about="http://example.org/university-kg#Week"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/university-kg#Resource"/>
        <rdfs:label>has resource</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#HAS_ASSESSMENT">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/university-kg#Module"/>
                    <rdf:Description rdf:about="http://example.org/university-kg#Week"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/university-kg#Assessment"/>
        <rdfs:label>has assessment</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-kg#EXTRACTED_FROM">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/university-kg#Week"/>
                    <rdf:Description rdf:about="http://example.org/university-kg#Topic"/>
                    <rdf:Description rdf:about="http://example.org/university-kg#Concept"/>
                    <rdf:Description rdf:about="http://example.org/university-kg#Resource"/>
                    <rdf:Description rdf:about="http://example.org/university-kg#Assessment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/university-kg#ProcessedDocument"/>
        <rdfs:label>extracted from</rdfs:label>
    </owl:ObjectProperty>


    <!-- ====================================================== -->
    <!-- General Data Properties -->
    <!-- ====================================================== -->

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#name">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#description">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>description</rdfs:label>
        <rdfs:comment>Optional short explanatory text. Can be used instead of separate Definition nodes.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#formula">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>formula</rdfs:label>
        <rdfs:comment>Optional formula stored as a property, not as a separate node.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#example">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>example</rdfs:label>
        <rdfs:comment>Optional example stored as a property, not as a separate node.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#application">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>application</rdfs:label>
        <rdfs:comment>Optional application/use case stored as a property, not as a separate node.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#confidence">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>confidence</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#sourceFile">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>source file</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#pageNumber">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>page number</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#chunkIndex">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>chunk index</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#sourceType">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>source type</rdfs:label>
    </owl:DatatypeProperty>


    <!-- ====================================================== -->
    <!-- Module Data Properties -->
    <!-- ====================================================== -->

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#moduleCode">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Module"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>module code</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#academicYear">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Module"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>academic year</rdfs:label>
    </owl:DatatypeProperty>


    <!-- ====================================================== -->
    <!-- Week Data Properties -->
    <!-- ====================================================== -->

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#weekNumber">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Week"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>week number</rdfs:label>
    </owl:DatatypeProperty>


    <!-- ====================================================== -->
    <!-- Assessment Data Properties -->
    <!-- ====================================================== -->

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#assessmentMonth">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Assessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>assessment month</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#isSummative">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Assessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is summative</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#weightingPercentage">
        <rdfs:domain rdf:resource="http://example.org/university-kg#Assessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>weighting percentage</rdfs:label>
    </owl:DatatypeProperty>


    <!-- ====================================================== -->
    <!-- Processed Document Data Properties -->
    <!-- ====================================================== -->

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#fileHash">
        <rdfs:domain rdf:resource="http://example.org/university-kg#ProcessedDocument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>file hash</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/university-kg#processedAt">
        <rdfs:domain rdf:resource="http://example.org/university-kg#ProcessedDocument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label>processed at</rdfs:label>
    </owl:DatatypeProperty>

</rdf:RDF>