@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix kg: <http://example.org/university-kg#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# SHACL validation rules for the clean University KG
# ============================================================
#
# Core graph structure:
#
# Module
#   HAS_WEEK -> Week
#     COVERS -> Topic
#       HAS_CONCEPT -> Concept
#
# Optional:
#
# Module / Week -> HAS_RESOURCE -> Resource
# Module / Week -> HAS_ASSESSMENT -> Assessment
# Week -> NEXT -> Week
# Concept -> RELATED_TO -> Concept
# Concept -> BUILDS_ON -> Concept
# Concept -> PREREQUISITE_OF -> Concept
#
# Removed as node types:
#
# Definition
# Example
# Formula
# Application
#
# These should not be created as graph nodes anymore.
# If needed, store them as string properties on Concept:
#
# kg:description
# kg:formula
# kg:example
# kg:application
#
# ============================================================


# ============================================================
# Module validation
# ============================================================

kg:ModuleShape
    a sh:NodeShape ;
    sh:targetClass kg:Module ;

    sh:property [
        sh:path kg:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 2 ;
        sh:maxLength 120 ;
        sh:message "Each Module must have a valid name." ;
    ] ;

    sh:property [
        sh:path kg:moduleCode ;
        sh:datatype xsd:string ;
        sh:maxLength 30 ;
        sh:message "Module code must be a short string if provided." ;
    ] ;

    sh:property [
        sh:path kg:academicYear ;
        sh:datatype xsd:string ;
        sh:maxLength 30 ;
        sh:message "Academic year must be a short string if provided." ;
    ] ;

    sh:property [
        sh:path kg:HAS_WEEK ;
        sh:class kg:Week ;
        sh:minCount 1 ;
        sh:message "Each Module must connect to at least one Week using HAS_WEEK." ;
    ] ;

    sh:property [
        sh:path kg:HAS_RESOURCE ;
        sh:class kg:Resource ;
        sh:message "HAS_RESOURCE from Module must point to Resource." ;
    ] ;

    sh:property [
        sh:path kg:HAS_ASSESSMENT ;
        sh:class kg:Assessment ;
        sh:message "HAS_ASSESSMENT from Module must point to Assessment." ;
    ] .


# ============================================================
# Week validation
# ============================================================

kg:WeekShape
    a sh:NodeShape ;
    sh:targetClass kg:Week ;

    sh:property [
        sh:path kg:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:pattern "^Week [0-9]+$" ;
        sh:message "Each Week must be named using the format 'Week 1', 'Week 2', etc." ;
    ] ;

    sh:property [
        sh:path kg:weekNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 60 ;
        sh:message "Week number must be a valid positive integer." ;
    ] ;

    sh:property [
        sh:path kg:COVERS ;
        sh:class kg:Topic ;
        sh:minCount 1 ;
        sh:message "Each Week must cover at least one Topic using COVERS." ;
    ] ;

    sh:property [
        sh:path kg:NEXT ;
        sh:class kg:Week ;
        sh:message "NEXT must connect one Week to another Week." ;
    ] ;

    sh:property [
        sh:path kg:HAS_RESOURCE ;
        sh:class kg:Resource ;
        sh:message "HAS_RESOURCE from Week must point to Resource." ;
    ] ;

    sh:property [
        sh:path kg:HAS_ASSESSMENT ;
        sh:class kg:Assessment ;
        sh:message "HAS_ASSESSMENT from Week must point to Assessment." ;
    ] .


# ============================================================
# Topic validation
# ============================================================

kg:TopicShape
    a sh:NodeShape ;
    sh:targetClass kg:Topic ;

    sh:property [
        sh:path kg:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 3 ;
        sh:maxLength 80 ;
        sh:message "Each Topic must have a clear academic topic name." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^(What|Why|How|When|Where|Which|Who)\\b" ;
            sh:flags "i" ;
        ] ;
        sh:message "Question-style text should not be stored as a Topic node." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^(Activity|Task|Question|Answer|Example|Exercise|Homework)\\b" ;
            sh:flags "i" ;
        ] ;
        sh:message "Activity, task, question, answer, example, or homework labels should not be stored as Topic nodes." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^[A-Z]=\\{" ;
        ] ;
        sh:message "Raw set values should not be stored as Topic names." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^[\\{\\}\\(\\)\\[\\],;:|∣∪∩⊆⊂×=+\\-*/0-9\\s]+$" ;
        ] ;
        sh:message "Formula-only or symbol-only text should not be stored as a Topic name." ;
    ] ;

    sh:property [
        sh:path kg:HAS_CONCEPT ;
        sh:class kg:Concept ;
        sh:minCount 1 ;
        sh:message "Each Topic must connect to at least one Concept using HAS_CONCEPT." ;
    ] ;

    sh:sparql [
        sh:message "A Topic must not have the same name as one of its Concept nodes." ;
        sh:select """
            PREFIX kg: <http://example.org/university-kg#>
            SELECT $this
            WHERE {
                $this kg:name ?topicName .
                $this kg:HAS_CONCEPT ?concept .
                ?concept kg:name ?conceptName .
                FILTER(LCASE(STR(?topicName)) = LCASE(STR(?conceptName)))
            }
        """ ;
    ] .


# ============================================================
# Concept validation
# ============================================================

kg:ConceptShape
    a sh:NodeShape ;
    sh:targetClass kg:Concept ;

    sh:property [
        sh:path kg:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 3 ;
        sh:maxLength 80 ;
        sh:message "Each Concept must have a clear concept name." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^(What|Why|How|When|Where|Which|Who)\\b" ;
            sh:flags "i" ;
        ] ;
        sh:message "Question-style text should not be stored as a Concept node." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^(Activity|Task|Question|Answer|Example|Exercise|Homework)\\b" ;
            sh:flags "i" ;
        ] ;
        sh:message "Activity, task, question, answer, example, or homework labels should not be stored as Concept nodes." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^(Definition|Description|Property|Attribute|Formula|Application|Note|Result|Method|Step|Object|Value|Reason|Benefit)$" ;
            sh:flags "i" ;
        ] ;
        sh:message "Generic metadata labels should not be stored as Concept nodes." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^(A|An|The)\\s+.+\\s+(is|are|means|refers to|represents|contains|consists of)\\b" ;
            sh:flags "i" ;
        ] ;
        sh:message "Sentence-style definitions should not be stored as Concept names." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^[A-Z]=\\{" ;
        ] ;
        sh:message "Raw set values should not be stored as Concept names." ;
    ] ;

    sh:property [
        sh:path kg:name ;
        sh:not [
            sh:pattern "^[\\{\\}\\(\\)\\[\\],;:|∣∪∩⊆⊂×=+\\-*/0-9\\s]+$" ;
        ] ;
        sh:message "Formula-only or symbol-only text should not be stored as a Concept name." ;
    ] ;

    sh:property [
        sh:path kg:description ;
        sh:datatype xsd:string ;
        sh:maxLength 500 ;
        sh:message "Concept description must be a string under 500 characters." ;
    ] ;

    sh:property [
        sh:path kg:formula ;
        sh:datatype xsd:string ;
        sh:maxLength 250 ;
        sh:message "Concept formula must be stored as a short string property, not as a Formula node." ;
    ] ;

    sh:property [
        sh:path kg:example ;
        sh:datatype xsd:string ;
        sh:maxLength 300 ;
        sh:message "Concept example must be stored as a short string property, not as an Example node." ;
    ] ;

    sh:property [
        sh:path kg:application ;
        sh:datatype xsd:string ;
        sh:maxLength 300 ;
        sh:message "Concept application must be stored as a short string property, not as an Application node." ;
    ] ;

    sh:property [
        sh:path kg:confidence ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Concept confidence must be between 0.0 and 1.0 if provided." ;
    ] ;

    sh:property [
        sh:path kg:RELATED_TO ;
        sh:class kg:Concept ;
        sh:message "RELATED_TO must connect one Concept to another Concept." ;
    ] ;

    sh:property [
        sh:path kg:BUILDS_ON ;
        sh:class kg:Concept ;
        sh:message "BUILDS_ON must connect one Concept to another Concept." ;
    ] ;

    sh:property [
        sh:path kg:PREREQUISITE_OF ;
        sh:class kg:Concept ;
        sh:message "PREREQUISITE_OF must connect one Concept to another Concept." ;
    ] ;

    sh:sparql [
        sh:message "A Concept must not have a relationship to itself." ;
        sh:select """
            PREFIX kg: <http://example.org/university-kg#>
            SELECT $this
            WHERE {
                {
                    $this kg:RELATED_TO $this .
                }
                UNION
                {
                    $this kg:BUILDS_ON $this .
                }
                UNION
                {
                    $this kg:PREREQUISITE_OF $this .
                }
            }
        """ ;
    ] .


# ============================================================
# Resource validation
# ============================================================

kg:ResourceShape
    a sh:NodeShape ;
    sh:targetClass kg:Resource ;

    sh:property [
        sh:path kg:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 3 ;
        sh:maxLength 150 ;
        sh:message "Each Resource must have a valid name." ;
    ] ;

    sh:property [
        sh:path kg:description ;
        sh:datatype xsd:string ;
        sh:maxLength 500 ;
        sh:message "Resource description must be a string under 500 characters if provided." ;
    ] ;

    sh:property [
        sh:path kg:sourceFile ;
        sh:datatype xsd:string ;
        sh:maxLength 250 ;
        sh:message "Resource source file must be a string if provided." ;
    ] .


# ============================================================
# Assessment validation
# ============================================================

kg:AssessmentShape
    a sh:NodeShape ;
    sh:targetClass kg:Assessment ;

    sh:property [
        sh:path kg:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 3 ;
        sh:maxLength 150 ;
        sh:message "Each Assessment must have a valid name." ;
    ] ;

    sh:property [
        sh:path kg:assessmentMonth ;
        sh:datatype xsd:string ;
        sh:maxLength 30 ;
        sh:message "Assessment month must be a short string if provided." ;
    ] ;

    sh:property [
        sh:path kg:isSummative ;
        sh:datatype xsd:boolean ;
        sh:message "isSummative must be a boolean if provided." ;
    ] ;

    sh:property [
        sh:path kg:weightingPercentage ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 100.0 ;
        sh:message "Assessment weighting percentage must be between 0 and 100 if provided." ;
    ] .